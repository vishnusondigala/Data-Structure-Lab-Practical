
#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

void insertAtEnd(struct Node **head_ref, int new_data);
void deleteFromBeginning(struct Node **head_ref);
void deleteFromEnd(struct Node **head_ref);
void deleteFromPosition(struct Node **head_ref, int position);
void displayList(struct Node *node);
void freeList(struct Node *head);

int main(void)
{
    struct Node *head = NULL;

    insertAtEnd(&head, 10);
    insertAtEnd(&head, 20);
    insertAtEnd(&head, 30);
    insertAtEnd(&head, 40);
    insertAtEnd(&head, 50);

    printf("Original List: ");
    displayList(head);

    deleteFromBeginning(&head);
    printf("After deleting from beginning: ");
    displayList(head);

    deleteFromEnd(&head);
    printf("After deleting from end: ");
    displayList(head);

    deleteFromPosition(&head, 2);
    printf("After deleting from position 2: ");
    displayList(head);

    freeList(head);

    return 0;
}

void insertAtEnd(struct Node **head_ref, int new_data)
{
    struct Node *new_node;
    struct Node *last;

    new_node = (struct Node *)malloc(sizeof(struct Node));

    if (new_node == NULL)
    {
        printf("Memory allocation failed!\n");
        exit(1);
    }

    new_node->data = new_data;
    new_node->next = NULL;

    if (*head_ref == NULL)
    {
        *head_ref = new_node;
        return;
    }

    last = *head_ref;

    while (last->next != NULL)
    {
        last = last->next;
    }

    last->next = new_node;
}

void deleteFromBeginning(struct Node **head_ref)
{
    struct Node *temp;

    if (*head_ref == NULL)
    {
        printf("List is empty. Deletion failed.\n");
        return;
    }

    temp = *head_ref;
    *head_ref = (*head_ref)->next;

    free(temp);
}

void deleteFromEnd(struct Node **head_ref)
{
    struct Node *temp;
    struct Node *prev;

    if (*head_ref == NULL)
    {
        printf("List is empty. Deletion failed.\n");
        return;
    }

    temp = *head_ref;

    if (temp->next == NULL)
    {
        *head_ref = NULL;
        free(temp);
        return;
    }

    while (temp->next != NULL)
    {
        prev = temp;
        temp = temp->next;
    }

    prev->next = NULL;
    free(temp);
}

void deleteFromPosition(struct Node **head_ref, int position)
{
    struct Node *temp;
    struct Node *nodeToDelete;
    int i;

    if (position < 1 || *head_ref == NULL)
    {
        printf("Invalid position or list is empty.\n");
        return;
    }

    temp = *head_ref;

    if (position == 1)
    {
        *head_ref = temp->next;
        free(temp);
        return;
    }

    for (i = 1; i < position - 1 && temp != NULL; i++)
    {
        temp = temp->next;
    }

    if (temp == NULL || temp->next == NULL)
    {
        printf("Position %d is out of bounds.\n", position);
        return;
    }

    nodeToDelete = temp->next;
    temp->next = nodeToDelete->next;

    free(nodeToDelete);
}

void displayList(struct Node *node)
{
    if (node == NULL)
    {
        printf("List is empty.\n");
        return;
    }

    while (node != NULL)
    {
        printf("%d -> ", node->data);
        node = node->next;
    }

    printf("NULL\n");
}

void freeList(struct Node *head)
{
    struct Node *temp;

    while (head != NULL)
    {
        temp = head;
        head = head->next;
        free(temp);
    }
}




// Output //
Original List: 10 -> 20 -> 30 -> 40 -> 50 -> NULL
After deleting from beginning: 20 -> 30 -> 40 -> 50 -> NULL
After deleting from end: 20 -> 30 -> 40 -> NULL
After deleting from position 2: 20 -> 40 -> NULL
